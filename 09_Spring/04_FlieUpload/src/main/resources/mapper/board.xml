<!--이거 mapper 타입임-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kh.upload.mapper.BoardMapper">

<resultMap id="boardMap" type="Board">
<id column="no" property="no"/>
<result column="title" property="title"/>
<result column="content" property="content"/>
<result column="url" property="url"/>
<result column="created_at" property="createdAt"/>
</resultMap>

<!--insert-->
<insert id="addBoard" parameterType="Board">
INSERT INTO board(title,content,url)
SELECT #{title}, #{content},#{url}
FROM DUAL
WHERE NOT EXISTS(
	SELECT 1 FROM board
	WHERE title = #{title}
	AND content = #{content}
	AND url = #{url}
)
</insert>

<insert id="insert" parameterType="Board" useGeneratedKeys="true" keyProperty="no" keyColumn="no">
INSERT INTO board(title,content,url)
VALUES(#{title}, #{content},#{url})
</insert>

<!--전체 조회-->
<select id="selectAll" resultMap="boardMap">
SELECT * FROM board
</select>

<!--조회-->

<!--<select id="select" parameterType="String" resultType="Board">
SELECT * FROM board
WHERE title LIKE CONCAT('%',#{keyword},'%')
OR content LIKE CONCAT('%',#{keyword},'%')
</select>
-->

<select id="search" parameterType="String" resultMap="boardMap">
SELECT * FROM board
WHERE title LIKE CONCAT('%', #{keyword},'%')
OR content LIKE CONCAT('%',#{keyword},'%')
</select>


<select id="select" parameterType="int" resultMap="boardMap">
SELECT * FROM board
WHERE no = #{no}
</select>

<!-- 수정 -->
<update id="update" parameterType="Board">
UPDATE board
<set>
<if test="title != null and title !=''">
title = #{title},
</if>
<if test="content != null and content !=''">
content = #{content},
</if>
<if test="url != null and url !='' ">
url = #{url},
</if>
</set>
WHERE no = #{no}
</update>


<!--삭제-->
<delete id="delete" parameterType="int">
DELETE FROM board
WHERE no = #{no}
</delete>

<select id="showBoard" resultType="BoardDTO">
SELECT * FROM film_text
</select>

<select id="showBoard1" parameterType="PageDTO" resultMap="BoardDTO">
SELECT * FROM board LIMIT #{offset}, #{limit}
</select>

<select id="total" resultType="int">
SELECT count(*) FROM board 
</select>







</mapper>