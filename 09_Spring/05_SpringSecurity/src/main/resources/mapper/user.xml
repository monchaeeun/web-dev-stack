<!--이거 mapper 타입임-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kh.security.mapper.UserMapper">

<select id="idCheck" parameterType="User" resultType="User">
SELECT * FROM user
WHERE id = #{id}
</select>

<insert id="addUser" parameterType="User">
INSERT INTO user(id, pwd, name,role)
VALUES(#{id},#{pwd}, #{name}, #{role})
</insert>

<select id="loginUser" parameterType="String" resultType="User">
SELECT * FROM user
WHERE id = #{id}
</select>

</mapper>