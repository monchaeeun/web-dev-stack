<!--이거 mapper 타입임-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kh.paging.mapper.filmMapper">

<resultMap id="Film1" type="Film">
<id  property="id" column="film_id"/>
<result  property="title" column="title"/>
<result  property="desc" column="description"/>
</resultMap>

<select id="showFilm" resultType="Film">
SELECT * FROM film_text
</select>

<select id="showFilm1" parameterType="PagingDTO" resultMap="Film1">
SELECT * FROM film_text LIMIT #{offset}, #{limit}
</select>

<select id="total" resultType="int">
SELECT count(*) FROM film_text 
</select>
</mapper>